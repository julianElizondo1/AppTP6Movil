@page "/proveedores"

@using AppTP6Movil.Models
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using AppTP6Movil.Services
@using AppTP6Movil.Components.Proveedores
@inject HttpClient Http
@inject SesionService Sesion
@inject IJSRuntime JS

<h3>Proveedores</h3>

@if (!mostrarFormulario)
{
    <button class="btn btn-primary mb-3"
            @onclick="NuevoProveedor">
        <i class="bi bi-plus-circle me-1"></i>
        Nuevo proveedor
    </button>
}
else
{
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">
                @(proveedorSeleccionado == null
                            ? "Nuevo proveedor"
                            : "Editar proveedor")
        </h5>
    </div>

        <div class="card-body">
            <FormProveedor ProveedorEditar="proveedorSeleccionado"
                           OnGuardar="GuardarProveedor" />

            <button class="btn btn-secondary mt-3"
                    @onclick="CancelarFormulario">
                Cancelar
            </button>
        </div>
    </div>
}

@if (cargando)
{
    <p>Cargando proveedores...</p>
}
else if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">
        @error
    </div>
}
else if (proveedores.Count == 0)
{
    <p>No hay proveedores registrados.</p>
}
else
{
    <div class="row">
        @foreach (var proveedor in proveedores)
        {
            <div class="col-md-6 col-lg-4 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@proveedor.Nombre</h5>

                        <p class="card-text">
                            <strong>Email:</strong> @proveedor.Email
                        </p>

                        <p class="card-text">
                            <strong>Teléfono:</strong> @proveedor.Telefono
                        </p>

                        <p class="card-text">
                            <strong>Dirección:</strong> @proveedor.Direccion
                        </p>
                        <div class="mt-3">
                            <button class="btn btn-warning btn-sm me-2"
                                    @onclick="() => EditarProveedor(proveedor)">
                                <i class="bi bi-pencil-square me-1"></i>
                                Editar
                            </button>

                            <button class="btn btn-danger btn-sm"
                                    @onclick="() => EliminarProveedor(proveedor)">
                                <i class="bi bi-trash me-1"></i>
                                Eliminar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Proveedor> proveedores = new();
    private bool mostrarFormulario = false;
    private bool cargando = true;
    private string error = string.Empty;
    private Proveedor? proveedorSeleccionado;

    protected override async Task OnInitializedAsync()
    {
        await CargarProveedores();
    }

    private async Task CargarProveedores()
    {
        try
        {
            var token = Sesion.ObtenerTokenValido();

            if (string.IsNullOrEmpty(token))
            {
                error = "La sesión expiró. Iniciá sesión nuevamente.";
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            proveedores = await Http.GetFromJsonAsync<List<Proveedor>>(
                "api/Proveedores") ?? new List<Proveedor>();
        }
        catch (Exception)
        {
            error = "No se pudieron cargar los proveedores.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void NuevoProveedor()
    {
        proveedorSeleccionado = null;
        mostrarFormulario = true;
        error = string.Empty;
    }

    private void EditarProveedor(Proveedor proveedor)
    {
        proveedorSeleccionado = proveedor;
        mostrarFormulario = true;
        error = string.Empty;
    }

    private void CancelarFormulario()
    {
        mostrarFormulario = false;
        proveedorSeleccionado = null;
    }

    private async Task GuardarProveedor(Proveedor proveedor)
    {
        try
        {
            var token = Sesion.ObtenerTokenValido();

            if (string.IsNullOrEmpty(token))
            {
                error = "La sesión expiró. Iniciá sesión nuevamente.";
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            HttpResponseMessage respuesta;

            if (proveedorSeleccionado == null)
            {
                respuesta = await Http.PostAsJsonAsync(
                    "api/Proveedores", proveedor);
            }
            else
            {
                respuesta = await Http.PutAsJsonAsync(
                    $"api/Proveedores/{proveedor.Id}", proveedor);
            }

            if (respuesta.IsSuccessStatusCode)
            {
                CancelarFormulario();
                error = string.Empty;

                await CargarProveedores();
            }
            else if (respuesta.StatusCode == System.Net.HttpStatusCode.Unauthorized ||
                     respuesta.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                error = "No tenés permisos para realizar esta operación.";
            }
            else
            {
                error = "No se pudo guardar el proveedor.";
            }
        }
        catch (Exception)
        {
            error = "Ocurrió un error al comunicarse con el servidor.";
        }
    }

    private async Task EliminarProveedor(Proveedor proveedor)
    {
        bool confirmar = await JS.InvokeAsync<bool>(
            "confirmarEliminacion",
            proveedor.Nombre
        );

        if (!confirmar)
        {
            return;
        }

        try
        {
            var token = Sesion.ObtenerTokenValido();

            if (string.IsNullOrEmpty(token))
            {
                error = "La sesión expiró. Iniciá sesión nuevamente.";
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            var respuesta = await Http.DeleteAsync(
                $"api/Proveedores/{proveedor.Id}");

            if (respuesta.IsSuccessStatusCode)
            {
                error = string.Empty;
                await CargarProveedores();
            }
            else if (respuesta.StatusCode == System.Net.HttpStatusCode.Unauthorized ||
                     respuesta.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                error = "No tenés permisos para eliminar proveedores.";
            }
            else
            {
                error = "No se pudo eliminar el proveedor.";
            }
        }
        catch (Exception)
        {
            error = "Ocurrió un error al comunicarse con el servidor.";
        }
    }
}