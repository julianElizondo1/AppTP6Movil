
@page "/login"
@using AppTP6Movil.Services
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@inject HttpClient Http
@inject SesionService Sesion


<PageTitle>Iniciar sesión</PageTitle>

<h3>Iniciar sesión</h3>

<div style="max-width: 400px;">
    <div class="mb-3">
        <label class="form-label">Usuario</label>
        <input class="form-control"
               @bind="username"
               autocomplete="username" />
    </div>

    <div class="mb-3">
        <label class="form-label">Contraseña</label>
        <input class="form-control"
               type="password"
               @bind="password"
               autocomplete="current-password" />
    </div>

    <button class="btn btn-primary"
            @onclick="IniciarSesion"
            disabled="@cargando">
        @(cargando ? "Ingresando..." : "Ingresar")
    </button>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <p class="mt-3">@mensaje</p>
    }
</div>

@code {
    private string username = "";
    private string password = "";
    private string mensaje = "";
    private bool cargando;

    private async Task IniciarSesion()
    {
        if (string.IsNullOrWhiteSpace(username) ||
            string.IsNullOrWhiteSpace(password))
        {
            mensaje = "Ingresá el usuario y la contraseña.";
            return;
        }

        cargando = true;
        mensaje = "";

        try
        {
            var respuesta = await Http.PostAsJsonAsync(
                "api/Auth/login",
                new LoginRequest(username, password));

            if (respuesta.IsSuccessStatusCode)
            {
                var resultado =
                    await respuesta.Content.ReadFromJsonAsync<LoginResponse>();

                if (resultado is not null &&
                    !string.IsNullOrWhiteSpace(resultado.Token))
                {
                    Sesion.GuardarSesion(
                        resultado.Token,
                        resultado.Username,
                        resultado.Rol,
                        new DateTimeOffset(
                            resultado.Expiracion.Kind == DateTimeKind.Utc
                                ? resultado.Expiracion
                                : resultado.Expiracion.ToUniversalTime()));

                    mensaje = $"¡Bienvenido, {Sesion.Username}!";
                }
                else
                {
                    mensaje = "La API no devolvió un token válido.";
                }
            }
            else if ((int)respuesta.StatusCode == 401)
            {
                mensaje = "Usuario o contraseña incorrectos.";
            }
            else
            {
                mensaje = $"Error de la API: {(int)respuesta.StatusCode}.";
            }
        }
        catch (HttpRequestException)
        {
            mensaje = "No se pudo conectar con la API.";
        }
        catch (System.Text.Json.JsonException)
        {
            mensaje = "La respuesta de la API no tiene el formato esperado.";
        }
        finally
        {
            cargando = false;
        }
    }

    private record LoginRequest(
        [property: JsonPropertyName("username")] string Username,
        [property: JsonPropertyName("password")] string Password);

    private record LoginResponse(
        [property: JsonPropertyName("token")] string Token,
        [property: JsonPropertyName("username")] string Username,
        [property: JsonPropertyName("rol")] string Rol,
        [property: JsonPropertyName("expiracion")] DateTime Expiracion);
}
