@page "/ingresos"

@using AppTP6Movil.Models
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using PdfSharpCore.Pdf
@using PdfSharpCore.Drawing
@using System.IO

@inject HttpClient Http
@inject AppTP6Movil.Services.SesionService Sesion
@inject AppTP6Movil.Services.RegistroService Registro

<h3 class="mb-4">
    <i class="bi bi-box-arrow-in-down me-2"></i>
    Historial de ingresos
</h3>
@if (cargando)
{
    <div class="text-center my-4">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2">Cargando ingresos...</p>
    </div>
}
else if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">
        @error
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span>
            Total de registros: <strong>@totalRegistros</strong>
        </span>

        <button class="btn btn-danger" @onclick="GenerarPDF">
            <i class="bi bi-file-earmark-pdf me-2"></i>
            Exportar PDF
        </button>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Fecha</th>
                    <th>Producto</th>
                    <th>Proveedor</th>
                    <th>Cantidad</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ingreso in ingresos)
                {
                    <tr>
                        <td>@ingreso.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@(ingreso.Producto?.Nombre ?? "Sin producto")</td>
                        <td>@(ingreso.Proveedor?.Nombre ?? "Sin proveedor")</td>
                        <td>@ingreso.Cantidad</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <button class="btn btn-outline-primary"
                @onclick="PaginaAnterior"
                disabled="@(paginaActual <= 1)">
            <i class="bi bi-chevron-left"></i> Anterior
        </button>

        <span>
            Página @paginaActual de @totalPaginas
        </span>

        <button class="btn btn-outline-primary"
                @onclick="PaginaSiguiente"
                disabled="@(paginaActual >= totalPaginas)">
            Siguiente <i class="bi bi-chevron-right"></i>
        </button>
    </div>
}

@code {
    private List<IngresoProductoDTO> ingresos = new();

    private bool cargando = true;
    private string error = string.Empty;

    private int paginaActual = 1;
    private int totalPaginas = 1;
    private int totalRegistros = 0;
    private const int tamanioPagina = 10;

    protected override async Task OnInitializedAsync()
    {
        await CargarIngresos();
    }

    private async Task CargarIngresos()
    {
        try
        {
            cargando = true;
            error = string.Empty;

            var token = Sesion.ObtenerTokenValido();

            if (string.IsNullOrEmpty(token))
                throw new Exception("La sesión no está activa.");

            using var solicitud = new HttpRequestMessage(
                HttpMethod.Get,
                $"api/IngresosProductos/paginado?pageNumber={paginaActual}&pageSize={tamanioPagina}"
            );

            solicitud.Headers.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            using var respuesta = await Http.SendAsync(solicitud);

            if (respuesta.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                Sesion.CerrarSesion();
                throw new Exception("La sesión venció. Iniciá sesión nuevamente.");
            }

            respuesta.EnsureSuccessStatusCode();

            var resultado = await respuesta.Content
                .ReadFromJsonAsync<RespuestaIngresosPaginados>();

            if (resultado == null)
                throw new Exception("No se pudo interpretar la respuesta de la API.");

            ingresos = resultado.Datos ?? new List<IngresoProductoDTO>();
            totalRegistros = resultado.TotalRegistros;
            totalPaginas = Math.Max(1, resultado.TotalPaginas);
        }
        catch (Exception ex)
        {
            error = $"Error al cargar los ingresos: {ex.Message}";

            await Registro.RegistrarErrorAsync(
                "Cargar historial de ingresos",
                ex
            );
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task PaginaAnterior()
    {
        if (paginaActual > 1)
        {
            paginaActual--;
            await CargarIngresos();
        }
    }

    private async Task PaginaSiguiente()
    {
        if (paginaActual < totalPaginas)
        {
            paginaActual++;
            await CargarIngresos();
        }
    }

    private async Task<List<IngresoProductoDTO>> ObtenerTodosLosIngresos()
    {
        var token = Sesion.ObtenerTokenValido();

        if (string.IsNullOrEmpty(token))
            throw new Exception("La sesión no está activa.");

        var todosLosIngresos = new List<IngresoProductoDTO>();

        int pagina = 1;
        int paginas = 1;

        do
        {
            using var solicitud = new HttpRequestMessage(
                HttpMethod.Get,
                $"api/IngresosProductos/paginado?pageNumber={pagina}&pageSize=100"
            );

            solicitud.Headers.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            using var respuesta = await Http.SendAsync(solicitud);

            if (respuesta.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                Sesion.CerrarSesion();
                throw new Exception("La sesión venció. Iniciá sesión nuevamente.");
            }

            respuesta.EnsureSuccessStatusCode();

            var resultado = await respuesta.Content
                .ReadFromJsonAsync<RespuestaIngresosPaginados>();

            if (resultado == null)
                throw new Exception("No se pudo interpretar la respuesta de la API.");

            if (resultado.Datos != null)
                todosLosIngresos.AddRange(resultado.Datos);

            paginas = resultado.TotalPaginas;
            pagina++;

        } while (pagina <= paginas);

        return todosLosIngresos;
    }

    private async Task GenerarPDF()
    {
        try
        {
            var todosLosIngresos = await ObtenerTodosLosIngresos();
            await Registro.RegistrarAuditoriaAsync(
                "Generar PDF",
                $"Reporte de ingresos. Registros incluidos: {todosLosIngresos.Count}"
            );

            using var documento = new PdfDocument();

            var fuenteTitulo = new XFont("Arial", 16, XFontStyle.Bold);
            var fuenteNormal = new XFont("Arial", 9, XFontStyle.Regular);
            var fuenteNegrita = new XFont("Arial", 9, XFontStyle.Bold);

            PdfPage? paginaPDF = null;
            XGraphics? gfx = null;

            double y = 0;

            void CrearPagina()
            {
                paginaPDF = documento.AddPage();
                paginaPDF.Size = PdfSharpCore.PageSize.A4;

                gfx = XGraphics.FromPdfPage(paginaPDF);

                gfx.DrawString(
                    "Reporte de ingresos de productos",
                    fuenteTitulo,
                    XBrushes.Black,
                    new XRect(30, 30, paginaPDF.Width - 60, 30),
                    XStringFormats.TopLeft
                );

                gfx.DrawString(
                    $"Fecha de generación: {DateTime.Now:dd/MM/yyyy HH:mm}",
                    fuenteNormal,
                    XBrushes.Black,
                    new XRect(30, 60, paginaPDF.Width - 60, 20),
                    XStringFormats.TopLeft
                );

                gfx.DrawString(
                    $"Total de ingresos: {todosLosIngresos.Count}",
                    fuenteNormal,
                    XBrushes.Black,
                    new XRect(30, 80, paginaPDF.Width - 60, 20),
                    XStringFormats.TopLeft
                );

                y = 125;

                gfx.DrawString("Fecha", fuenteNegrita, XBrushes.Black, new XRect(30, y, 100, 20));
                gfx.DrawString("Producto", fuenteNegrita, XBrushes.Black, new XRect(135, y, 150, 20));
                gfx.DrawString("Proveedor", fuenteNegrita, XBrushes.Black, new XRect(290, y, 150, 20));
                gfx.DrawString("Cantidad", fuenteNegrita, XBrushes.Black, new XRect(445, y, 90, 20));

                y += 20;

                gfx.DrawLine(XPens.Black, 30, y, paginaPDF.Width - 30, y);

                y += 10;
            }

            CrearPagina();

            foreach (var ingreso in todosLosIngresos)
            {
                if (y > paginaPDF!.Height - 50)
                {
                    gfx!.Dispose();
                    CrearPagina();
                }

                gfx!.DrawString(
                    ingreso.Fecha.ToLocalTime().ToString("dd/MM/yyyy"),
                    fuenteNormal,
                    XBrushes.Black,
                    new XRect(30, y, 100, 20)
                );

                gfx.DrawString(
                    ingreso.Producto?.Nombre ?? "Sin producto",
                    fuenteNormal,
                    XBrushes.Black,
                    new XRect(135, y, 150, 20)
                );

                gfx.DrawString(
                    ingreso.Proveedor?.Nombre ?? "Sin proveedor",
                    fuenteNormal,
                    XBrushes.Black,
                    new XRect(290, y, 150, 20)
                );

                gfx.DrawString(
                    ingreso.Cantidad.ToString(),
                    fuenteNormal,
                    XBrushes.Black,
                    new XRect(445, y, 90, 20)
                );

                y += 20;
            }

            gfx?.Dispose();

            using var stream = new MemoryStream();

            documento.Save(stream);
            stream.Position = 0;

            var nombreArchivo = $"Reporte_Ingresos_{DateTime.Now:yyyyMMdd_HHmmss}.pdf";
            var rutaArchivo = Path.Combine(FileSystem.CacheDirectory, nombreArchivo);

            await File.WriteAllBytesAsync(rutaArchivo, stream.ToArray());

            await Share.Default.RequestAsync(
                new ShareFileRequest
                {
                    Title = "Reporte de ingresos",
                    File = new ShareFile(rutaArchivo)
                }
            );
        }
        catch (Exception ex)
        {
            error = $"Error al generar el PDF: {ex.Message}";

            await Registro.RegistrarErrorAsync(
                "Generar PDF de ingresos",
                ex
            );
        }
    }
}